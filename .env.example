# Bronnenregister — kopieer naar .env en vul je eigen waarden in (.env blijft lokaal)
# Clinicminds Analytics-API: app.clinicminds.com -> instellingen -> Analytics-API
CLINICMINDS_API_TOKEN=zet-hier-je-eigen-token
CLINICMINDS_API_BASE=https://app.clinicminds.com/api/analytics
CLINICMINDS_API_SPEC=https://app.clinicminds.com/api/analytics/spec

# Typeform Responses API: admin.typeform.com -> Settings -> Personal tokens
TYPEFORM_TOKEN=zet-hier-je-eigen-token

# Klanttevredenheid-formulier (form-ID uit de Typeform-URL)
TYPEFORM_FORM_KLANTTEVREDENHEID=form-id-hier
